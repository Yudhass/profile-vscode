{"name":"Yudha Python","settings":"{\"settings\":\"{\\r\\n    \\\"workbench.colorTheme\\\": \\\"Bearded Theme Black & Gold\\\",\\r\\n    \\\"[php]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"bmewburn.vscode-intelephense-client\\\"\\r\\n    },\\r\\n    \\\"workbench.preferredHighContrastLightColorTheme\\\": \\\"Monokai\\\",\\r\\n    \\\"workbench.preferredHighContrastColorTheme\\\": \\\"Palenight Theme\\\",\\r\\n    \\\"editor.fontFamily\\\": \\\"Fira Code\\\",\\r\\n    // \\\"editor.fontFamily\\\": \\\"Consolas, 'Courier New', monospace,Fira Code\\\",\\r\\n    \\\"editor.fontLigatures\\\": true,\\r\\n    \\\"editor.formatOnType\\\": true,\\r\\n    \\\"[html]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.html-language-features\\\"\\r\\n    },\\r\\n    \\\"[javascript]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.typescript-language-features\\\"\\r\\n    },\\r\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\r\\n    \\\"editor.fontSize\\\": 20,\\r\\n    \\\"editor.accessibilityPageSize\\\": 20,\\r\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\",\\r\\n    \\\"backgroundCover.randomImageFolder\\\": \\\"c:\\\\\\\\Users\\\\\\\\bimab\\\\\\\\OneDrive\\\\\\\\Pictures\\\",\\r\\n    \\\"backgroundCover.imagePath\\\": \\\"c:\\\\\\\\Users\\\\\\\\bimab\\\\\\\\OneDrive\\\\\\\\Pictures\\\\\\\\black-asta-demon-black-clover-wallpaper-3840x2160_54.jpg\\\",\\r\\n    \\\"backgroundCover.autoStatus\\\": false,\\r\\n    \\\"backgroundCover.opacity\\\": 0.2,\\r\\n    \\\"[javascriptreact]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.typescript-language-features\\\"\\r\\n    },\\r\\n    \\\"[css]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.css-language-features\\\"\\r\\n    },\\r\\n    \\\"editor.stickyScroll.enabled\\\": true,\\r\\n    \\\"editor.bracketPairColorization.independentColorPoolPerBracketType\\\": true,\\r\\n    \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\r\\n    \\\"editor.cursorBlinking\\\": \\\"expand\\\",\\r\\n    \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\r\\n    \\\"terminal.integrated.fontSize\\\": 20,\\r\\n    \\\"notebook.output.textLineLimit\\\": 500,\\r\\n    \\\"notebook.lineNumbers\\\": \\\"on\\\",\\r\\n    \\\"jupyter.textOutputLimit\\\": 0,\\r\\n    \\\"notebook.output.scrolling\\\": true,\\r\\n    \\\"git.openRepositoryInParentFolders\\\": \\\"never\\\",\\r\\n    \\\"diffEditor.maxFileSize\\\": 30,\\r\\n    \\\"window.zoomLevel\\\": -1,\\r\\n    \\\"[python]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"ms-python.autopep8\\\"\\r\\n    },\\r\\n    \\\"github.copilot.nextEditSuggestions.enabled\\\": true,\\r\\n    \\\"chat.tools.terminal.autoApprove\\\": {\\r\\n        \\\"echo \\\\\\\"=== FINAL PROJECT FILES ===\\\\\\\" && find . -maxdepth 1 -type f \\\\\\\\( -name \\\\\\\"*.md\\\\\\\" -o -name \\\\\\\"*.py\\\\\\\" -o -name \\\\\\\"*.txt\\\\\\\" -o -name \\\\\\\"*.sh\\\\\\\" -o -name \\\\\\\".env*\\\\\\\" \\\\\\\\) ! -path \\\\\\\"./venv*\\\\\\\" | sort && echo \\\\\\\"\\\\\\\" && echo \\\\\\\"Total files created:\\\\\\\" && find . -maxdepth 1 -type f ! -path \\\\\\\"./venv*\\\\\\\" ! -path \\\\\\\"./_JUST_DEVEL*\\\\\\\" | wc -l\\\": {\\r\\n            \\\"approve\\\": true,\\r\\n            \\\"matchCommandLine\\\": true\\r\\n        },\\r\\n        \\\"od\\\": true,\\r\\n        \\\"cd /home/yudhas/Dokumen/GIT_DESKTOP/Jawalens/WacaJawa && python3 << 'EOF'\\\\nimport requests\\\\nimport json\\\\n\\\\n# Test dengan file yang ada\\\\nfiles_in_upload = []\\\\nimport os\\\\nfor f in os.listdir('uploads'):\\\\n    if f.endswith(('.png', '.jpg', '.jpeg')):\\\\n        files_in_upload.append(f)\\\\n        print(f\\\\\\\"Found: {f}\\\\\\\")\\\\n\\\\nif files_in_upload:\\\\n    test_file = files_in_upload[0]\\\\n    print(f\\\\\\\"\\\\\\\\nTesting with: {test_file}\\\\\\\")\\\\n    \\\\n    response = requests.post('http://localhost:5000/api/process', \\\\n        json={'filename': test_file, 'model_id': 'model_1'},\\\\n        timeout=60\\\\n    )\\\\n    \\\\n    print(f\\\\\\\"Status: {response.status_code}\\\\\\\")\\\\n    data = response.json()\\\\n    print(f\\\\\\\"Keys in response: {data.keys()}\\\\\\\")\\\\n    print(f\\\\\\\"\\\\\\\\nLatin text: '{data.get('latin_text', 'EMPTY')}'\\\\\\\")\\\\n    print(f\\\\\\\"Jawa text: '{data.get('jawa_text', 'EMPTY')}'\\\\\\\")\\\\n    print(f\\\\\\\"\\\\\\\\nFull response (pretty printed):\\\\\\\")\\\\n    print(json.dumps(data, indent=2)[:2000])\\\\nelse:\\\\n    print(\\\\\\\"No image files found in uploads/\\\\\\\")\\\\nEOF\\\\n\\\": {\\r\\n            \\\"approve\\\": true,\\r\\n            \\\"matchCommandLine\\\": true\\r\\n        }\\r\\n    },\\r\\n    \\\"chat.viewSessions.orientation\\\": \\\"stacked\\\",\\r\\n    \\\"git.enableSmartCommit\\\": true,\\r\\n    \\\"git.confirmSync\\\": false,\\r\\n    \\\"editor.wordWrap\\\": \\\"on\\\",\\r\\n    \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\r\\n    \\\"9router-for-github-copilot.serverUrl\\\": \\\"http://localhost:20128/v1\\\"\\r\\n}\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaults\\n[\\n    {\\n        \\\"key\\\": \\\"shift+alt+s\\\",\\n        \\\"command\\\": \\\"filesExplorer.findInFolder\\\",\\n        \\\"when\\\": \\\"explorerResourceIsFolder && filesExplorerFocus && foldersViewVisible && !inputFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+alt+f\\\",\\n        \\\"command\\\": \\\"-filesExplorer.findInFolder\\\",\\n        \\\"when\\\": \\\"explorerResourceIsFolder && filesExplorerFocus && foldersViewVisible && !inputFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+alt+s\\\",\\n        \\\"command\\\": \\\"search.action.restrictSearchToFolder\\\",\\n        \\\"when\\\": \\\"folderMatchWithResourceFocus && searchViewletVisible\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+alt+f\\\",\\n        \\\"command\\\": \\\"-search.action.restrictSearchToFolde